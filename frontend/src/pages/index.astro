---
/* LIVE-DOC:START — astro-drf-aws live-doc; see [[adr-19-live-doc-backlinks]]
 * Governed by: [[adr-08-frontend-and-design-system]]
 * Docs: [[FRONTEND]]
 * LIVE-DOC:END */
import Base from "../layouts/Base.astro";
import { HomeCardsView } from "$lib/components/views";
import { NAV_ITEMS } from "$lib/components/shell/nav";
import { loadSession, DENIED_QUERY } from "$lib/authGate";
import { hasRole } from "$lib/auth";
import { t } from "../i18n";

const me = await loadSession(Astro.request);
// A role-less session bounced off a gated page arrives with `?denied=1`
// (requireRole, $lib/authGate) — surface a visible reason, not a silent
// redirect ([[adr-21-authorization-lobby]]).
const denied = Astro.url.searchParams.get(DENIED_QUERY) === "1";
// Signed-in with zero groups = lobby pending (adr-20); anonymous sees shell only.
const pending = me !== null && !hasRole(me);
const roleHolding = hasRole(me);

Astro.response.headers.set("Cache-Control", "no-store");

const items = roleHolding
  ? NAV_ITEMS.map((item) => ({
      href: item.href,
      icon: item.icon,
      title: t(item.labelKey),
      abstract: t(item.abstractKey),
    }))
  : [];
---

<Base title={t("home_cards_title")} {me}>
  <HomeCardsView
    denied={denied}
    pending={pending}
    items={items}
    copy={{
      deniedTitle: t("denied_title"),
      deniedBody: t("denied_body"),
      pendingTitle: t("pending_title"),
      pendingBody: t("lobby_pending"),
      cardsTitle: t("home_cards_title"),
    }}
  />
</Base>

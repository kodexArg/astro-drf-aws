---
/* LIVE-DOC:START — astro-drf-aws live-doc; see [[adr-19-live-doc-backlinks]]
 * Governed by: [[adr-08-frontend-and-design-system]] · [[adr-28-nav-fsm-frosted-rail]]
 * Docs: [[FRONTEND]] · [[DESIGN-SYSTEM]]
 * LIVE-DOC:END */
import "../styles/app.css";
import { ClientRouter, fade } from "astro:transitions";
import { parseThemeConfig, computeThemeSSRAttrs, DEFAULTS } from "$lib/theme";
import { parseNavLockCookie } from "$lib/components/shell/nav-fsm";
import { hasRole } from "$lib/auth";
import { t } from "../i18n";
import PageTitle from "$lib/components/primitives/titles/PageTitle.svelte";
import LayoutHeader from "$lib/components/header/LayoutHeader.svelte";
import PageCanvas from "$lib/components/primitives/PageCanvas.svelte";
import SessionBadge from "$lib/components/auth/SessionBadge.svelte";
import NavDrawer from "$lib/components/shell/NavDrawer.svelte";
import ChatDrawer from "$lib/components/shell/ChatDrawer.svelte";
import type { Me } from "$lib/types/user";

/** Soft page crossfade — short enough to feel calm, not sluggish. */
const PAGE_FADE = fade({ duration: "150ms" });

interface Props {
  title?: string;
  me?: Me | null;
}

const { title = process.env.PUBLIC_PROJECT_SLUG ?? "astro-drf-aws", me = null } = Astro.props;

const publicBackendUrl = process.env.PUBLIC_BACKEND_URL ?? "http://localhost:8000";

// SSR, no-flash theme apply (bdd-06 "Persistence across login — no flash";
// [[DESIGN-SYSTEM]]): the `theme` cookie — set by the backend on login and
// on a successful `PATCH /api/me/` ([[API]]) — is parsed and sanitized here,
// server-side, before the first byte renders.
const themeConfig = parseThemeConfig(Astro.cookies.get("theme")?.value);
const { htmlClass, dataBgPreset, style } = computeThemeSSRAttrs(themeConfig);
const navSide = themeConfig.sidebarSide ?? DEFAULTS.sidebarSide;
const chatSide = navSide === "right" ? "left" : "right";

// Lock preference from `nav_lock` cookie — same no-flash class as `theme`
// ([[adr-28-nav-fsm-frosted-rail]]). Viewport band is CSS on first paint.
const navPreference = parseNavLockCookie(Astro.cookies.get("nav_lock")?.value);
// Assistant context is the current path identity only — never page text (adr-24).
const pageIdentity = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
---

<!doctype html>
<html lang="en" class={htmlClass} data-bg-preset={dataBgPreset} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PageTitle title={title} />
    <ClientRouter />
  </head>

  <body>
    <LayoutHeader {title}>
      <Fragment slot="session">
        <SessionBadge
          client:load
          me={me}
          pending={me !== null && !hasRole(me)}
          publicBackendUrl={publicBackendUrl}
          loginHref={`${publicBackendUrl}/accounts/login/`}
          logoutAction={`${publicBackendUrl}/accounts/logout/`}
          panelHref="/profile/"
          loginLabel={t("auth_login")}
          logoutLabel={t("auth_logout")}
        />
      </Fragment>
    </LayoutHeader>

    <PageCanvas transition:animate={PAGE_FADE}>
      <slot />
    </PageCanvas>

    {
      /* Role-gated: a role-less visitor is confined to `/`
         ([[adr-21-authorization-lobby]] rule 1). */
      hasRole(me) && (
        <NavDrawer
          client:load
          transition:persist="shell-nav"
          pathname={Astro.url.pathname}
          side={navSide}
          preference={navPreference}
          navigates
        />
      )
    }
    {
      /* Opposite edge of the nav drawer; same role gate (adr-24 page-context). */
      hasRole(me) && (
        <ChatDrawer
          client:load
          side={chatSide}
          page={pageIdentity}
          publicBackendUrl={publicBackendUrl}
          copy={{
            title: t("chatui_assistant_title"),
            composerPlaceholder: t("chatui_assistant_composer_placeholder"),
            composerAriaLabel: t("chatui_composer_aria_label"),
            composerSend: t("chatui_composer_send"),
            messageGo: t("chatui_message_go"),
            messageConfirm: t("chatui_message_confirm"),
            outcomeCopy: {
              assistant_outcome_disabled: t("assistant_outcome_disabled"),
              assistant_outcome_throttled: t("assistant_outcome_throttled"),
              assistant_outcome_unavailable: t("assistant_outcome_unavailable"),
              assistant_outcome_network_error: t("assistant_outcome_network_error"),
              assistant_outcome_validation_error: t("assistant_outcome_validation_error"),
            },
          }}
        />
      )
    }

    <script>
      import "htmx.org";
    </script>

    <script>
      // Docked state is derived from the sentinel's own visibility, not scroll
      // math, so it stays correct across resize/zoom.
      const sentinel = document.querySelector("[data-nav-sentinel]");
      const header = document.querySelector("[data-nav-header]");
      if (sentinel && header) {
        new IntersectionObserver(
          ([entry]) => {
            header.toggleAttribute("data-docked", !entry.isIntersecting);
          },
          { threshold: 0 },
        ).observe(sentinel);
      }
    </script>
  </body>
</html>

#!/bin/sh
# The dispatch safety net's voice at commit time (adr-27-guardians-and-delivery).
#
# Install once per clone:
#   ln -s ../../hooks/khook-pre-commit .git/hooks/pre-commit
#
# It warns, it does not block: the gate cannot see whether a guardian was
# already dispatched this batch, so blocking would only teach --no-verify.
# Name-only form on purpose — no --bundle flood at commit. The owner re-runs
# with --bundle when dispatching (adr-04).
python3 "$(git rev-parse --show-toplevel)/hooks/khook-guardian-dispatch" --staged || true


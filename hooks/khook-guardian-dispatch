#!/usr/bin/env python3
"""guardian-dispatch — the dispatch safety net (adr-27-guardians-and-delivery).

Maps a batch of changed files against the paths governed by each active ADR
and its related guardian agents (adr-00-adr-doctrine rule 3), plus any watch:
globs declared by agents, and names the guardians the owner process must
dispatch before the batch closes.

With `--bundle`, also emits the owner-dispatch payload (adr-04): hit
files, unified diff for those hits, and a live ADR trigger index so the
ADR guardian's fast path never opens ADR bodies unnecessarily.

Runtime-agnostic: git + python3 stdlib, zero dependencies.

Usage:
  guardian-dispatch              batch = working tree vs HEAD, plus untracked
  guardian-dispatch --staged     batch = staged files only (pre-commit)
  guardian-dispatch <ref>        batch = files changed since <ref>
  guardian-dispatch --bundle …   same batch selection, plus dispatch payload

Exit 0: no guardian owed. Exit 1: dispatch owed (named on stdout).
Globs are fnmatch-style; `*` crosses `/`, so `adrs/*` covers nesting.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from fnmatch import fnmatch
from pathlib import Path

DIFF_SOFT_CAP = 80_000  # bytes; truncate with a note past this


def repo_root() -> Path:
    for var in ("ANTIGRAVITY_PROJECT_DIR", "CLAUDE_PROJECT_DIR", "PROJECT_ROOT"):
        val = os.environ.get(var)
        if val and Path(val).is_dir():
            return Path(val)
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True,
        )
        return Path(out.stdout.strip())
    except Exception:
        return Path(__file__).resolve().parents[1]


COLOR_RED = "\033[91m"
COLOR_RESET = "\033[0m"
GUARDIANS = {"kbot-prd", "kbot-adr", "kbot-bdd", "kbot-api"}


def current_branch(root: Path) -> str:
    override = os.environ.get("HARNESS_GIT_BRANCH", "").strip()
    if override:
        return override
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=root,
            capture_output=True,
            text=True,
            check=True,
        )
        return out.stdout.strip()
    except Exception:
        return ""


def is_main_to_main(root: Path, argv: list[str]) -> tuple[bool, str]:
    branch = current_branch(root)
    if branch != "main":
        return False, f"rama actual '{branch}' != 'main'"

    refs = [a for a in argv if not a.startswith("-")]
    if refs:
        target = refs[0]
        if target not in ("main", "origin/main", "refs/heads/main", "HEAD"):
            return False, f"target ref '{target}' != 'main'"

    return True, "main a main"


def git_lines(*args: str) -> list[str]:
    out = subprocess.run(
        ["git", *args], cwd=repo_root(), capture_output=True, text=True, check=True,
    )
    return [line for line in out.stdout.splitlines() if line.strip()]


def git_text(*args: str) -> str:
    out = subprocess.run(
        ["git", *args], cwd=repo_root(), capture_output=True, text=True, check=False,
    )
    return out.stdout


def changed_files(argv: list[str]) -> list[str]:
    if "--staged" in argv:
        return git_lines("diff", "--name-only", "--cached")
    refs = [a for a in argv if not a.startswith("-")]
    if refs:
        return git_lines("diff", "--name-only", refs[0])
    tracked = git_lines("diff", "--name-only", "HEAD")
    untracked = git_lines("ls-files", "--others", "--exclude-standard")
    return sorted(set(tracked + untracked))


def parse_frontmatter_block(text: str) -> str:
    match = re.match(r"\A---\n(.*?)\n---", text, re.DOTALL)
    return match.group(1) if match else ""


def parse_sequence(fm_block: str, key: str) -> list[str]:
    match = re.search(rf"^{key}:[ \t]*(.*)$", fm_block, re.MULTILINE)
    if not match:
        return []
    inline = match.group(1).strip()
    if inline.startswith("[") and inline.endswith("]"):
        return [i.strip().strip("\"'") for i in inline[1:-1].split(",") if i.strip()]
    if inline and not inline.startswith("#"):
        return [inline.strip("\"'")]
    items = []
    tail = fm_block[fm_block.index(f"\n{key}:") + 1 :] if f"\n{key}:" in fm_block else fm_block
    for line in tail.splitlines()[1:]:
        if re.match(r"^\s*-\s+", line):
            items.append(line.split("-", 1)[1].strip().strip("\"'"))
        elif line.strip() and not line.startswith((" ", "\t")):
            break
    return items


def parse_scalar(fm_block: str, key: str) -> str:
    match = re.search(rf"^{key}:[ \t]*(.*)$", fm_block, re.MULTILINE)
    return match.group(1).strip().strip("\"'") if match else ""


def watchlists(root: Path) -> dict[str, list[str]]:
    """Derive watchlists for guardians (kbot-prd, kbot-adr) from ADRs and agent definitions."""
    lists: dict[str, list[str]] = {}

    # 1. ADR-driven watchlists: adrs/adr-*.md
    adrs_dir = root / "adrs"
    if adrs_dir.is_dir():
        for path in sorted(adrs_dir.glob("adr-*.md")):
            try:
                text = path.read_text(encoding="utf-8")
            except OSError:
                continue
            fm_block = parse_frontmatter_block(text)
            if not fm_block:
                continue
            paths = parse_sequence(fm_block, "paths")
            agents = parse_sequence(fm_block, "related_agents")
            for agent in agents:
                if agent not in GUARDIANS:
                    continue
                lists.setdefault(agent, [])
                for p in paths:
                    if p not in lists[agent]:
                        lists[agent].append(p)


    # 2. Agent-declared watchlists (watch: or paths: in agents/*.md for guardians)
    agents_dir = root / "agents"
    if agents_dir.is_dir():
        for path in sorted(agents_dir.glob("*.md")):
            if path.stem not in GUARDIANS:
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except OSError:
                continue
            fm_block = parse_frontmatter_block(text)
            if not fm_block:
                continue
            globs = parse_sequence(fm_block, "watch") or parse_sequence(fm_block, "paths")
            if globs:
                lists.setdefault(path.stem, [])
                for g in globs:
                    if g not in lists[path.stem]:
                        lists[path.stem].append(g)

    return lists


def adr_index(adrs_dir: Path) -> list[tuple[str, str, str]]:
    """Live index: (slug, status, applies_when/description) for every ADR."""
    rows: list[tuple[str, str, str]] = []
    if not adrs_dir.is_dir():
        return rows
    for path in sorted(adrs_dir.glob("adr-*.md")):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        fm_block = parse_frontmatter_block(text)
        if not fm_block:
            continue
        title = parse_scalar(fm_block, "title") or path.stem
        status = parse_scalar(fm_block, "status") or "active"
        applies_when = parse_scalar(fm_block, "applies_when")
        desc = parse_scalar(fm_block, "description")
        info = applies_when if applies_when else desc
        rows.append((title, status, info))
    return rows


def hit_diff(root: Path, hits: list[str], argv: list[str]) -> str:
    """Unified diff for hit paths only (staged / since-ref / worktree)."""
    if not hits:
        return ""
    if "--staged" in argv:
        return git_text("diff", "--cached", "--", *hits)
    refs = [a for a in argv if not a.startswith("-")]
    if refs:
        return git_text("diff", refs[0], "--", *hits)

    parts: list[str] = []
    tracked_hits: list[str] = []
    for f in hits:
        checked = subprocess.run(
            ["git", "ls-files", "--error-unmatch", f],
            cwd=root, capture_output=True, text=True,
        )
        if checked.returncode != 0:
            file_path = root / f
            if file_path.is_file():
                body = file_path.read_text(encoding="utf-8", errors="replace")
                parts.append(
                    f"diff --git a/{f} b/{f}\n"
                    f"--- /dev/null\n+++ b/{f}\n"
                    + "".join(f"+{line}\n" for line in body.splitlines())
                )
        else:
            tracked_hits.append(f)
    if tracked_hits:
        parts.append(git_text("diff", "HEAD", "--", *tracked_hits))
    return "".join(parts)


def print_bundle(
    root: Path,
    owed: dict[str, list[str]],
    argv: list[str],
) -> None:
    all_hits = sorted({h for hits in owed.values() for h in hits})
    print("--- bundle (adr-27-guardians-and-delivery) ---")
    print("protocol: two-phase-fast-triage  # Phase 1: evaluate diff only; Phase 2: escalate only if diff indicates violations")
    print("tier: cheap  # pin fast model; escalate only if triage fails")
    print("parallel: yes  # when more than one guardian is owed, dispatch in one turn")
    print()
    print("## owed")
    for guardian, hits in sorted(owed.items()):
        print(f"- {guardian}:")
        for h in hits:
            print(f"  - {h}")
    print()
    print("## adr_index  # applies_when / description — evaluate diff against index; open full files only after triage hits")
    for name, status, info in adr_index(root / "adrs"):
        print(f"- {name} | {status} | {info}")
    print()
    print("## diff")
    diff = hit_diff(root, all_hits, argv)
    raw = diff.encode("utf-8")
    if len(raw) > DIFF_SOFT_CAP:
        print(diff[:DIFF_SOFT_CAP])
        print(
            f"\n# [truncated: {len(raw)} bytes > {DIFF_SOFT_CAP}; "
            f"re-run git diff for full text]"
        )
    else:
        print(diff if diff.strip() else "# (empty diff)")
    print("--- end bundle ---")


def main(argv: list[str]) -> int:
    root = repo_root()
    valid, reason = is_main_to_main(root, argv)
    if not valid:
        print(f"{COLOR_RED}[HARNESS BYPASS] khook-guardian-dispatch: bypass activado porque no es diff de main a main ({reason}).{COLOR_RESET}")
        return 0

    want_bundle = "--bundle" in argv
    files = changed_files(argv)
    if not files:
        print("guardian-dispatch: empty batch — no guardian owed.")
        return 0

    owed: dict[str, list[str]] = {}
    for guardian, globs in watchlists(root).items():
        hits = [f for f in files if any(fnmatch(f, g) for g in globs)]
        if hits:
            owed[guardian] = hits

    if not owed:
        print(f"guardian-dispatch: {len(files)} file(s) in batch — no guardian owed.")
        return 0

    print(f"guardian-dispatch: {len(owed)} guardian(s) owed for this batch (adr-27-guardians-and-delivery)")
    for guardian, hits in sorted(owed.items()):
        shown = ", ".join(hits[:4]) + (f", +{len(hits) - 4} more" if len(hits) > 4 else "")
        print(f"  -> {guardian} — {len(hits)} file(s): {shown}")
    print("Dispatch each before the batch closes; violation/danger blocks.")
    if want_bundle:
        print()
        print_bundle(root, owed, argv)
    else:
        print("Owner: re-run with --bundle and paste that payload into each guardian prompt (adr-04).")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

